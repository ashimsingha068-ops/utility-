<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Micro-Tool | Free AI Video Title, Bio & Hashtag Generator</title>
    <meta name="description" content="AI Micro-Tool offers free AI-powered tools for content creators: Video Title Generator, Instagram Bio Generator, and Hashtag Generator. Fast, simple, and SEO-friendly micro tools.">
    <meta name="keywords" content="AI video title generator, AI bio generator, Instagram bio generator, hashtag generator, AI micro tools, content creator tools, YouTube title maker">
